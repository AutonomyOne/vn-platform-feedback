{
  "name": "platform-feedback",
  "version": "0.2.0",
  "description": "Single-import feedback SDK for all platform frontend microservices",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".":            { "types": "./src/index.d.ts", "default": "./src/index.js" },
    "./components": { "types": "./src/components/index.d.ts", "default": "./src/components/FeedbackButton.jsx" },
    "./components/FeedbackButton.vue": "./src/components/FeedbackButton.vue",
    "./react":      "./src/integrations/react.js",
    "./nextjs":     "./src/integrations/nextjs.js",
    "./vue":        "./src/integrations/vue.js",
    "./angular":    "./src/angular/feedback.module.ts",
    "./express":    "./src/integrations/express.js",
    "./browser":    "./src/integrations/browser.js"
  },
  "peerDependencies": {
    "react":   ">=18",
    "vue":     ">=3",
    "@angular/core": ">=17"
  },
  "peerDependenciesMeta": {
    "react":            { "optional": true },
    "vue":              { "optional": true },
    "@angular/core":    { "optional": true }
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "vitest": "^3.0.0"
  },
  "keywords": ["feedback", "platform", "bug-reporting"],
  "license": "UNLICENSED"
}
