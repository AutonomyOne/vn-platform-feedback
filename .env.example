# Required env vars for platform-feedback SDK
# Copy this file and rename to .env, .env.python, or .env.next as needed

# --- Python / Express / Node.js ---
FEEDBACK_SERVICE_URL=https://your-feedback-service.example.com
FEEDBACK_API_KEY=your-api-key
FEEDBACK_APP_NAME=your-app-name
FEEDBACK_MICROSERVICE=backend
FEEDBACK_ENV=staging

# --- Next.js (prefix with NEXT_PUBLIC_) ---
# NEXT_PUBLIC_FEEDBACK_SERVICE_URL=https://your-feedback-service.example.com
# NEXT_PUBLIC_FEEDBACK_API_KEY=your-api-key
# NEXT_PUBLIC_FEEDBACK_APP_NAME=your-app-name
# NEXT_PUBLIC_FEEDBACK_MICROSERVICE=frontend
# NEXT_PUBLIC_FEEDBACK_ENV=staging

# --- Vite (prefix with VITE_) ---
# VITE_FEEDBACK_SERVICE_URL=https://your-feedback-service.example.com
# VITE_FEEDBACK_API_KEY=your-api-key
# VITE_FEEDBACK_APP_NAME=your-app-name
# VITE_FEEDBACK_MICROSERVICE=frontend
# VITE_FEEDBACK_ENV=staging
